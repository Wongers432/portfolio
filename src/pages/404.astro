---
import Base from '../layouts/Base.astro';
import MiniHeader from '../components/MiniHeader.astro';
---
<Base title="Page not found · Oliver Wong">
  <div class="page">
    <MiniHeader />
    <main id="main" class="nf">
      <span class="label">404 · 0.00°N 0.00°E</span>
      <h1>Page not found</h1>
      <p class="prose">There's nothing at this address.</p>
      <p><a class="btn primary" href="/">Back to the home page</a></p>
    </main>
  </div>
</Base>
<style>
  .nf { margin-top: 64px; display: grid; gap: 14px; justify-items: start; }
  h1 { font-size: 40px; font-weight: 600; }
  p { margin: 0; }
</style>
