---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import PhoneScreen from '../../components/PhoneScreen.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/cv';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
---
<Base title={`${p.name} · Oliver Wong`} description={p.summary}>
  <div class="wrap">
    <TopBar home={false} />
    <main id="main" class="case">
      <div class="intro">
        <a class="back lbl" href="/#cartridges">← All cartridges</a>
        <span class="lbl">Cartridge · {p.kind}</span>
        <h1>{p.name}</h1>
        <p class="lede">{p.summary}</p>
        <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
        <dl class="facts">
          {p.facts.map((f) => (<><dt>{f.k}</dt><dd>{f.v}</dd></>))}
        </dl>
        <div class="btns">
          {p.liveUrl
            ? <a class="btn solid" href={p.liveUrl} rel="noopener">Open full app ↗</a>
            : <span class="btn solid" aria-disabled="true">Live link coming soon</span>}
          <a class="btn" href={p.repo} rel="noopener">Source ↗</a>
        </div>
        {p.story.map((s) => (
          <section class="story">
            <h2>{s.heading}</h2>
            <p class="prose">{s.body}</p>
          </section>
        ))}
      </div>

      <aside class="demo" aria-label="Try the app">
        <div class="device">
          {p.demoUrl ? (
            <div class="screen" data-demo={p.demoUrl} data-title={`${p.name} demo`}>
              <PhoneScreen slug={p.slug} />
              <button class="btn solid try" type="button">Try it here</button>
            </div>
          ) : (
            <div class="screen">
              <PhoneScreen slug={p.slug} />
            </div>
          )}
        </div>
        <p class="note lbl">
          {p.demoUrl
            ? 'Loads the real app on click. On a phone, open the full app instead.'
            : 'Sample screen. The live demo goes here once the app is deployed.'}
        </p>
      </aside>
    </main>
    <Footer />
  </div>
</Base>
<script>
  // Load the app only when asked, so the page stays fast. Phones go to the full app instead.
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((screen) => {
    const btn = screen.querySelector('button');
    btn?.addEventListener('click', () => {
      const url = screen.dataset.demo!;
      if (matchMedia('(max-width: 700px)').matches) {
        location.href = url;
        return;
      }
      const f = document.createElement('iframe');
      f.src = url;
      f.title = screen.dataset.title ?? 'App demo';
      f.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms');
      f.setAttribute('referrerpolicy', 'no-referrer');
      f.setAttribute('loading', 'eager');
      screen.replaceChildren(f);
    });
  });
</script>
<style>
  .case { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; align-items: start; }
  .intro { min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .back { text-decoration: none; color: var(--ink); }
  h1 { font-weight: 800; font-size: clamp(44px, 7vw, 84px); line-height: 0.9; letter-spacing: -0.03em; color: var(--ink); }
  .lede { font-size: 19px; max-width: 56ch; margin: 0; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; font: 400 13px/1.5 var(--mono); margin: 0; border-top: 1px solid var(--ink); padding-top: 12px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .story { margin-top: 20px; }
  .story h2 { font-size: 26px; }
  .demo { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 12px; }
  .device { border: 2px solid var(--text); box-shadow: 6px 6px 0 var(--ink); padding: 12px; background: var(--ground); }
  .screen { aspect-ratio: 9 / 19.5; max-width: 100%; position: relative; display: grid; place-items: center; background: var(--wash); }
  .screen :global(.phone) { width: 70%; border-width: 1px; }
  .screen :global(iframe) { width: 100%; height: 100%; border: 0; display: block; background: var(--ground); }
  .try { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); }
  .try:hover { transform: translate(calc(-50% + 2px), 2px); }
  .note { text-transform: none; letter-spacing: 0; }
  @media (max-width: 860px) {
    .case { grid-template-columns: 1fr; }
    .demo { position: static; max-width: 300px; }
  }
</style>
