---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import PhoneScreen from '../../components/PhoneScreen.astro';
import Footer from '../../components/Footer.astro';
import { projects, type Project } from '../../data/cv';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Project };
---
<Base title={`${p.name} · Oliver Wong`} description={p.summary}>
  <TopBar home={false} />
  <div class="page">
    <main id="main" class="case">
      <div class="intro">
        <a class="back" href="/#projects">← All projects</a>
        <div class="title">
          <img src={`/apps/${p.slug}.png`} width="64" height="64" alt="" />
          <div>
            <span class="label">Project · {p.kind}</span>
            <h1>{p.name}</h1>
          </div>
        </div>
        <p class="lede">{p.summary}</p>
        <dl class="facts">
          {p.facts.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
        </dl>
        <div class="btns">
          {p.liveUrl
            ? <a class="btn primary" href={p.liveUrl} rel="noopener">Open the app ↗</a>
            : <span class="btn primary" aria-disabled="true">Live link coming soon</span>}
          <a class="btn" href={p.repo} rel="noopener">Source code ↗</a>
        </div>
        {p.story.map((s) => (
          <section class="story">
            <h2>{s.heading}</h2>
            <p class="prose">{s.body}</p>
          </section>
        ))}
      </div>

      <aside class="demo" aria-label="Try the app">
        <div class="device">
          <div class="screen" data-demo={p.demoUrl ?? undefined} data-title={`${p.name} demo`}>
            <PhoneScreen slug={p.slug} />
            {p.demoUrl && <button class="btn primary try" type="button">Try it here</button>}
          </div>
        </div>
        <p class="note">
          {p.demoUrl
            ? 'Loads the real app on click. On a phone, this opens the full app instead.'
            : 'Sample screen. The live demo goes here once the app is deployed.'}
        </p>
      </aside>
    </main>
    <Footer />
  </div>
</Base>
<script>
  // Load the app only when asked, so the page stays fast. Phones go to the full app instead.
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((screen) => {
    const btn = screen.querySelector('button');
    btn?.addEventListener('click', () => {
      const url = screen.dataset.demo!;
      if (matchMedia('(max-width: 700px)').matches) {
        location.href = url;
        return;
      }
      const f = document.createElement('iframe');
      f.src = url;
      f.title = screen.dataset.title ?? 'App demo';
      f.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms');
      f.setAttribute('referrerpolicy', 'no-referrer');
      screen.replaceChildren(f);
    });
  });
</script>
<style>
  .case { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 72px; align-items: start; margin-top: 8px; }
  .intro { min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .back { font-size: 14px; }
  .title { display: flex; gap: 18px; align-items: center; }
  .title img { width: 64px; height: 64px; display: block; }
  h1 { font-size: clamp(32px, 5vw, 44px); line-height: 1.1; font-weight: 600; letter-spacing: -0.015em; margin-top: 4px; }
  .lede { font-size: 19px; line-height: 1.6; max-width: 58ch; margin: 0; }
  .facts { margin: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 12px 0; display: grid; gap: 6px; }
  .facts div { display: grid; grid-template-columns: 90px 1fr; gap: 16px; font-size: 15px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .story { margin-top: 16px; }
  .story h2 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
  .demo { position: sticky; top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .device { border: 1px solid var(--rule); padding: 12px; background: var(--tint); }
  .screen { aspect-ratio: 9 / 19.5; max-width: 100%; position: relative; display: grid; place-items: center; }
  .screen :global(.phone) { width: 78%; }
  .screen :global(iframe) { width: 100%; height: 100%; border: 0; display: block; background: var(--ground); }
  .try { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); }
  .note { margin: 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 860px) {
    .case { grid-template-columns: 1fr; gap: 40px; }
    .demo { position: static; max-width: 300px; }
  }
</style>
