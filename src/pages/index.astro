---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Intro from '../components/Intro.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Beyond from '../components/Beyond.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { person, experience, education } from '../data/cv';
---
<Base>
  <TopBar />
  <div class="page">
    <main id="main" class="col">
      <Intro />
      <section class="section" id="about">
        <h2>About</h2>
        <p class="prose lead">{person.about}</p>
      </section>
      <Timeline id="experience" heading="Experience" items={experience} />
      <Projects />
      <Timeline id="education" heading="Education" items={education} />
      <Skills />
      <Beyond />
      <Contact />
    </main>
    <div class="col"><Footer /></div>
  </div>
</Base>
<style>
  .col { max-width: 860px; }
  .lead { font-size: 19px; line-height: 1.6; color: var(--text); }
  @media (max-width: 600px) { .lead { font-size: 17px; } }
</style>
