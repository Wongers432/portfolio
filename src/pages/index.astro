---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Beyond from '../components/Beyond.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { person, experience, education } from '../data/cv';
---
<Base>
  <div class="wrap">
    <TopBar />
    <main id="main" class="stack">
      <Hero />
      <section class="panel" id="about">
        <h2>About</h2>
        <p class="prose">{person.about}</p>
      </section>
      <Timeline id="experience" heading="Experience" items={experience} />
      <Projects />
      <Timeline id="education" heading="Education" items={education} />
      <Skills />
      <Beyond />
      <Contact />
    </main>
    <Footer />
  </div>
</Base>
<style>
  .stack { display: flex; flex-direction: column; gap: 56px; }
</style>
