---
import { skills } from '../data/cv';
---
<section class="section" id="skills">
  <h2>Skills</h2>
  <dl>
    {skills.map((g) => (<div class="row"><dt>{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>))}
  </dl>
</section>
<style>
  dl { margin: 0; display: grid; gap: 14px; }
  .row { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; }
  dt { font-weight: 600; font-size: 15px; }
  dd { margin: 0; color: var(--soft); }
  @media (max-width: 600px) { .row { grid-template-columns: 1fr; gap: 2px; } }
</style>
