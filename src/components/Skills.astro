---
import { skills } from '../data/cv';
---
<section id="skills">
  <h2>Skills</h2>
  <div class="cols">
    {skills.map((g) => (
      <div class="col">
        <h3 class="lbl">{g.group}</h3>
        <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
      </div>
    ))}
  </div>
</section>
<style>
  .cols { margin-top: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .col { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 14px 16px; min-width: 0; }
  h3 { color: var(--ink); margin-bottom: 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 15px; }
</style>
