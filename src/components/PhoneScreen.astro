---
// A phone showing each app in its own colours, with its real home-screen icon.
// The colours are the apps' own brand, so they stay the same in light and dark mode.
import { projects } from '../data/cv';
interface Props { slug: string }
const { slug } = Astro.props;
const p = projects.find((x) => x.slug === slug)!;
const tiers = [
  { lift: 'Deadlift', tier: 'Platinum', w: 78 },
  { lift: 'Bench', tier: 'Gold', w: 60 },
  { lift: 'Squat', tier: 'Silver', w: 44 },
  { lift: 'Pull-up', tier: 'Gold', w: 64 },
];
// 7 x 4 dungeon map: 0 empty, 1 room, 2 start, 3 wither door, 4 blood room
const rooms = [2,1,1,0,1,1,0, 0,1,3,1,1,1,0, 1,1,0,1,0,3,1, 0,1,1,1,0,1,4];
---
<div class:list={['phone', slug]} aria-hidden="true">
  <div class="nt"></div>
  <div class="head">
    <img src={`/apps/${slug}.png`} width="40" height="40" alt="" loading="lazy" decoding="async" />
    <span>{p.name}</span>
  </div>
  {slug === 'liftboard' ? (
    <div class="ui">
      <div class="rank"><small>Overall</small><b>GOLD</b></div>
      {tiers.map((t) => (
        <div class="lift">
          <span>{t.lift}</span><span class="t">{t.tier}</span>
          <svg viewBox="0 0 100 4" preserveAspectRatio="none"><rect width="100" height="4" class="track" /><rect width={t.w} height="4" class="fill" /></svg>
        </div>
      ))}
      <svg class="chart" viewBox="0 0 100 34"><polyline points="0,30 14,27 28,25 42,20 56,18 70,12 84,9 100,4" fill="none" stroke-width="2" /></svg>
    </div>
  ) : (
    <div class="ui">
      <div class="rank"><small>Floor VII</small><b>S+</b></div>
      <div class="grid">{rooms.map((r) => <i class={`r${r}`}></i>)}</div>
      <div class="lift"><span>Boss</span><span class="t">Necron</span></div>
      <div class="lift"><span>Secrets</span><span class="t">9 / 10</span></div>
      <div class="lift"><span>Crypts</span><span class="t">5</span></div>
    </div>
  )}
</div>
<style>
  .phone {
    --bg: #0b0b10; --panel: #17171d; --fg: #f2f2f5; --dim: #8a8a96; --accent: #ff5f2a; --track: #2a2a33;
    width: 132px; max-width: 100%; aspect-ratio: 9 / 19; border: 2px solid var(--text); padding: 8px;
    background: var(--bg); color: var(--fg); display: flex; flex-direction: column; gap: 8px; font: 400 9px/1.3 var(--mono);
  }
  .phone.skyblock-dungeons { --bg: #1d1d22; --panel: #2a2a31; --dim: #8d8d97; --accent: #d42020; --track: #45454d; }
  .nt { height: 5px; width: 40%; background: var(--track); margin: 0 auto; }
  .head { display: flex; align-items: center; gap: 8px; font: 800 12px/1.1 var(--display); }
  .head img { width: 34px; height: 34px; flex: none; image-rendering: pixelated; }
  .ui { display: flex; flex-direction: column; gap: 6px; }
  .rank { display: flex; justify-content: space-between; align-items: baseline; background: var(--panel); padding: 5px 6px; }
  .rank small { color: var(--dim); font-size: 9px; }
  .rank b { font: 800 14px/1 var(--display); color: var(--accent); }
  .lift { display: grid; grid-template-columns: 1fr auto; gap: 2px 6px; border-bottom: 1px solid var(--track); padding-bottom: 3px; }
  .lift .t { color: var(--dim); }
  .lift svg { grid-column: 1 / -1; width: 100%; height: 3px; display: block; }
  .track { fill: var(--track); }
  .fill { fill: var(--accent); }
  .chart { width: 100%; stroke: var(--accent); margin-top: 2px; }
  .grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .grid i { aspect-ratio: 1; background: transparent; }
  .grid .r1 { background: var(--track); }
  .grid .r2 { background: #3fa34d; }
  .grid .r3 { background: #111; outline: 1px solid var(--dim); outline-offset: -1px; }
  .grid .r4 { background: var(--accent); }
</style>
