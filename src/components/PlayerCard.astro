---
import { person } from '../data/cv';
---
<header class="hero">
  <div class="avatar" aria-hidden="true">{person.initials}</div>
  <div>
    <div class="lbl">Player</div>
    <h1>{person.name}</h1>
    <div class="chips">{person.chips.map((c) => <span class="chip">{c}</span>)}</div>
    <dl class="bars">
      {person.bars.map((b) => (
        <div class="bar">
          <dt>{b.label}</dt>
          <dd>
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
              <rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
              <rect x="0" y="0" width={b.value} height="10" fill="currentColor" />
            </svg>
          </dd>
          <dd class="note">{b.note}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>
<style>
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; }
  .avatar { width: 148px; height: 148px; border: 1px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); display: grid; place-items: center; font: 800 60px/1 var(--display); color: var(--ink); background: var(--wash); letter-spacing: -0.04em; }
  h1 { font-weight: 800; font-size: clamp(48px, 8.5vw, 100px); line-height: 0.9; letter-spacing: -0.03em; color: var(--ink); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip { font: 400 12px/1 var(--mono); padding: 8px 10px; border: 1px solid var(--ink); color: var(--ink); }
  .bars { display: grid; gap: 8px; margin: 18px 0 0; max-width: 440px; }
  .bar { display: grid; grid-template-columns: 96px 1fr 104px; gap: 10px; align-items: center; font: 400 12px/1 var(--mono); }
  .bar dd { margin: 0; color: var(--ink); }
  .bar svg { display: block; width: 100%; height: 10px; }
  .bar .note { color: var(--muted); text-align: right; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .avatar { width: 96px; height: 96px; font-size: 40px; }
  }
  @media (max-width: 480px) { .bar { grid-template-columns: 76px 1fr 88px; } }
</style>
