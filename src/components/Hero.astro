---
import { person } from '../data/cv';
---
<header class="hero">
  <div class="avatar" aria-hidden="true">{person.initials}</div>
  <div>
    <div class="lbl">{person.role}</div>
    <h1>{person.name}</h1>
    <dl class="facts">
      {person.facts.map((f) => (<div><dt>{f.k}</dt><dd>{f.v}</dd></div>))}
    </dl>
    <div class="btns">
      <a class="btn solid" href="#contact">Get in touch</a>
      <a class="btn" href={person.linkedin} rel="noopener me">LinkedIn ↗</a>
      <a class="btn" href={person.github} rel="noopener me">GitHub ↗</a>
    </div>
  </div>
</header>
<style>
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 28px; align-items: center; }
  .avatar { width: 148px; height: 148px; border: 1px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); display: grid; place-items: center; font: 800 60px/1 var(--display); color: var(--ink); background: var(--wash); letter-spacing: -0.04em; }
  h1 { font-weight: 800; font-size: clamp(48px, 8.5vw, 100px); line-height: 0.9; letter-spacing: -0.03em; color: var(--ink); margin-top: 6px; }
  .facts { display: grid; gap: 4px; margin: 18px 0 20px; font: 400 13px/1.5 var(--mono); }
  .facts div { display: grid; grid-template-columns: 96px 1fr; gap: 12px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; }
    .avatar { width: 96px; height: 96px; font-size: 40px; }
  }
</style>
