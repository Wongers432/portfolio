---
import { places } from '../data/cv';
---
<section id="journey">
  <h2>Journey</h2>
  <figure class="map">
    <canvas data-places={JSON.stringify(places)} role="img" aria-label={`Routes from ${places[0].name} to ${places.filter((p) => p.tag && p.tag !== 'home').map((p) => p.name).join(', ')}`}></canvas>
    <figcaption>Equirectangular · 15° graticule · every trip plotted from home</figcaption>
  </figure>
  <ul class="legend">
    {places.filter((p) => p.label !== false).map((p) => (
      <li><b>{p.name}</b><span>{Math.abs(p.lat).toFixed(2)}°{p.lat >= 0 ? 'N' : 'S'} {Math.abs(p.lon).toFixed(2)}°{p.lon >= 0 ? 'E' : 'W'} · {p.tag}</span></li>
    ))}
  </ul>
</section>
<script src="../scripts/map.ts"></script>
<style>
  .map { border: 1px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); position: relative; aspect-ratio: 3 / 1; max-width: 100%; margin: 18px 0 0; }
  .map canvas { width: 100%; height: 100%; display: block; }
  figcaption { position: absolute; left: 10px; bottom: 8px; font: 400 11px/1 var(--mono); color: var(--muted); }
  .legend { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .legend li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 10px 12px; }
  .legend b { display: block; font: 500 15px/1.2 var(--display); }
  .legend span { font: 400 11px/1.4 var(--mono); color: var(--muted); }
  @media (max-width: 600px) { .map { aspect-ratio: 2 / 1; } figcaption { display: none; } }
</style>
