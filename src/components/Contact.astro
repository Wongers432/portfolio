---
import { person } from '../data/cv';
---
<section class="section" id="contact">
  <h2>Contact</h2>
  <p class="prose">I'm looking for placement and internship opportunities in cyber security. Email is the best way to reach me.</p>
  <div class="row">
    <span class="email">{person.email}</span>
    <button class="btn" type="button" data-copy={person.email}>Copy email</button>
    <a class="btn" href={person.cvPdf} download>Download CV ↓</a>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy ?? '');
        b.textContent = 'Copied';
      } catch {
        const s = window.getSelection();
        const el = b.previousElementSibling;
        if (s && el) { const r = document.createRange(); r.selectNodeContents(el); s.removeAllRanges(); s.addRange(r); }
        b.textContent = 'Selected, press copy';
      }
      setTimeout(() => (b.textContent = 'Copy email'), 2000);
    });
  });
</script>
<style>
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin-top: 18px; }
  .email { font: 500 17px/1.4 var(--sans); user-select: all; margin-right: 8px; }
</style>
