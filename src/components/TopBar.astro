---
import { person } from '../data/cv';
interface Props { home?: boolean }
const { home = true } = Astro.props;
const p = home ? '' : '/';
const tabs = [
  ['about', 'About'], ['experience', 'Experience'], ['projects', 'Projects'], ['education', 'Education'],
  ['skills', 'Skills'], ['travel', 'Beyond the CV'], ['contact', 'Contact'],
];
---
<div class="bar">
  <div class="inner">
    <a class="name" href="/">{person.name}</a>
    <nav aria-label="Sections">
      <ul>{tabs.map(([id, name]) => <li><a href={`${p}#${id}`}>{name}</a></li>)}</ul>
    </nav>
  </div>
</div>
<style>
  .bar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    background: var(--ground);
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: max(24px, env(safe-area-inset-left, 0px));
    padding-right: max(24px, env(safe-area-inset-right, 0px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 56px;
  }
  .name { font-weight: 600; font-size: 16px; color: var(--text); text-decoration: none; white-space: nowrap; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 4px; }
  nav a { display: block; padding: 17px 10px 16px; color: var(--muted); text-decoration: none; font-size: 14px; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  nav a:hover { color: var(--text); border-bottom-color: var(--text); }
  @media (max-width: 899px) {
    .inner { flex-direction: column; align-items: stretch; gap: 0; padding-top: 10px; }
    nav { overflow-x: auto; scrollbar-width: none; margin: 0 -10px; }
    nav::-webkit-scrollbar { display: none; }
    nav a { padding: 10px 10px 12px; }
  }
  @media (max-width: 600px) {
    .inner { padding-left: max(18px, env(safe-area-inset-left, 0px)); padding-right: max(18px, env(safe-area-inset-right, 0px)); }
  }
</style>
