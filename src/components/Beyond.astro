---
import { places, beyond } from '../data/cv';
---
<section class="section" id="travel">
  <h2>Beyond the CV</h2>
  <figure class="map">
    <canvas data-places={JSON.stringify(places)} role="img" aria-label={`World map with routes from ${places[0].name} to ${places.filter((p) => p.tag && p.tag !== 'home').map((p) => p.name).join(', ')}`}></canvas>
  </figure>
  <dl>
    {beyond.map((b) => (<div class="row"><dt>{b.title}</dt><dd>{b.text}</dd></div>))}
  </dl>
</section>
<script src="../scripts/map.ts"></script>
<style>
  .map { margin: 0 0 28px; border: 1px solid var(--rule); aspect-ratio: 2.2 / 1; max-width: 100%; background: var(--ground); }
  .map canvas { width: 100%; height: 100%; display: block; }
  dl { margin: 0; display: grid; gap: 14px; }
  .row { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; }
  dt { font-weight: 600; font-size: 15px; }
  dd { margin: 0; color: var(--soft); }
  @media (max-width: 600px) {
    .map { aspect-ratio: 2 / 1; }
    .row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
