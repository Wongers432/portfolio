---
import type { Entry } from '../data/cv';
interface Props { id: string; heading: string; items: Entry[] }
const { id, heading, items } = Astro.props;
---
<section class="section" id={id}>
  <h2>{heading}</h2>
  <ol class="rows">
    {items.map((q) => (
      <li class="row">
        <div class="when">
          <span>{q.when}</span>
          {q.where && <span class="where">{q.where}</span>}
        </div>
        <div class="what">
          <h3>{q.title}</h3>
          <p class="role">{q.role}</p>
          {q.points && <ul>{q.points.map((pt) => <li>{pt}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 32px; }
  .row { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; }
  .when { display: flex; flex-direction: column; font: 400 13px/1.6 var(--mono); color: var(--muted); padding-top: 2px; }
  h3 { font-size: 18px; font-weight: 600; line-height: 1.35; }
  .role { margin: 2px 0 0; color: var(--muted); font-size: 15px; }
  ul { margin: 10px 0 0; padding-left: 18px; color: var(--soft); max-width: 66ch; }
  li li { margin-top: 4px; }
  ul li + li { margin-top: 6px; }
  @media (max-width: 600px) {
    .row { grid-template-columns: 1fr; gap: 6px; }
    .when { flex-direction: row; gap: 10px; flex-wrap: wrap; }
    .where::before { content: '· '; }
  }
</style>
