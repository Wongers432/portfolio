---
import type { Entry } from '../data/cv';
interface Props { id: string; heading: string; items: Entry[] }
const { id, heading, items } = Astro.props;
---
<section id={id}>
  <h2>{heading}</h2>
  <ol class="log">
    {items.map((q, i) => (
      <li class:list={['q', { main: i === 0 }]}>
        <div class="when"><b>{q.when}</b>{q.where}</div>
        <div>
          <h3>{q.title}</h3>
          <p>{q.role}</p>
          {q.points && <ul>{q.points.map((pt) => <li>{pt}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .log { list-style: none; margin: 20px 0 0; position: relative; display: grid; gap: 18px; padding-left: 34px; }
  .log::before { content: ''; position: absolute; left: 8px; top: 6px; bottom: 6px; border-left: 2px dashed var(--ink); }
  .q { position: relative; display: grid; grid-template-columns: 170px 1fr; gap: 18px; border: 1px solid var(--line); padding: 16px; }
  .q::before { content: ''; position: absolute; left: -32px; top: 18px; width: 14px; height: 14px; background: var(--ground); border: 2px solid var(--ink); }
  .q.main { border-color: var(--ink); box-shadow: 5px 5px 0 var(--ink); }
  .q.main::before { background: var(--ink); }
  .when { font: 400 12px/1.5 var(--mono); color: var(--muted); }
  .when b { display: block; font: 500 12px/1.4 var(--mono); color: var(--ink); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px; }
  h3 { font-weight: 800; font-size: 22px; line-height: 1.1; }
  p { margin: 4px 0 0; color: var(--muted); }
  ul { margin: 8px 0 0; padding-left: 18px; max-width: 66ch; }
  @media (max-width: 820px) { .q { grid-template-columns: 1fr; gap: 6px; } }
</style>
