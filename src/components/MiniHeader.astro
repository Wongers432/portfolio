---
import { person } from '../data/cv';
---
<header class="mini">
  <a class="name" href="/">{person.name}</a>
  <nav class="links" aria-label="Site">
    <a href="/#projects">Projects</a>
    <a href="/#experience">Experience</a>
    <a href="/#contact">Contact</a>
    <a href={person.cvPdf} download>Download CV ↓</a>
  </nav>
</header>
<style>
  .mini { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 10px 24px; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
  .name { font-weight: 600; font-size: 17px; color: var(--text); text-decoration: none; }
</style>
