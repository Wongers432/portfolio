---
import { projects } from '../data/cv';
---
<section class="section" id="projects">
  <h2>Projects</h2>
  <ul class="list">
    {projects.map((p) => (
      <li class="proj">
        <img src={`/apps/${p.slug}.png`} width="72" height="72" alt={`${p.name} app icon`} decoding="async" />
        <div class="body">
          <div class="head">
            <h3><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
            <span class="label">{p.kind}</span>
          </div>
          <p>{p.summary}</p>
          <p class="tech">{p.tags.join(' · ')}</p>
          <div class="links">
            <a href={`/projects/${p.slug}`}>Case study →</a>
            {p.liveUrl && <a href={p.liveUrl} rel="noopener">Open the app ↗</a>}
            <a href={p.repo} rel="noopener">Source code ↗</a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 36px; }
  .proj { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 24px; align-items: start; }
  img { display: block; width: 72px; height: 72px; image-rendering: auto; }
  .head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  h3 { font-size: 18px; font-weight: 600; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 6px 0 0; color: var(--soft); max-width: 62ch; }
  .tech { margin-top: 8px; }
  .links { margin-top: 10px; }
  @media (max-width: 600px) {
    .proj { grid-template-columns: 56px minmax(0, 1fr); gap: 16px; }
    img { width: 56px; height: 56px; }
  }
</style>
